# shellcheck shell=bash
# Demo 3 - Resource management
: "${NS:=demo-resources}"
: "${NS_DISPLAY:=Resources}"
: "${NS_DESCRIPTION:=OpenShift Resource Management Demo}"
: "${ADMIN_USER:=peter}"   # sets up the demo; quotas, nodes, dashboards, VPA
: "${EDIT_USER:=user3}"    # developer - edit role, sizes the app, hits the quota
: "${VIEW_USER:=user2}"    # read-only - view role
# The guestbook image: built by setup from demo 1's source in Gitea
# (ocpdemo/<repo>, pushed there by demo1-fundamentals/setup.sh)
: "${GUESTBOOK_REPO:=guestbook}"
: "${GUESTBOOK_REVISION:=main}"
# Part 7 (optional): login for the "fedora" user in small-vm (virtctl console)
: "${VM_PASSWORD:=welcome1}"
# Background traffic for Cost Management (traffic.yml) - its own project, so
# it stays out of the demo's quota and Topology
: "${TRAFFIC_NS:=demo-resources-traffic}"
