# shellcheck shell=bash
# Demo 3 - Resource management
: "${NS:=demo-resources}"
: "${NS_DISPLAY:=Resources}"
: "${NS_DESCRIPTION:=OpenShift Resource Management Demo}"
: "${ADMIN_USER:=peter}"   # sets up the demo; quotas, nodes, dashboards, VPA
: "${EDIT_USER:=user1}"    # developer - edit role, sizes the app, hits the quota
: "${VIEW_USER:=user2}"    # read-only - view role
