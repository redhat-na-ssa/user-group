# shellcheck shell=bash
# Demo 1 - OpenShift fundamentals
: "${NS:=demo-intro}"
: "${NS_DISPLAY:=Introduction}"
: "${NS_DESCRIPTION:=Introduction to OpenShift Demo}"
: "${ADMIN_USER:=peter}"   # sets up the demo
: "${EDIT_USER:=user1}"    # developer - edit role, drives most of the demo
: "${VIEW_USER:=user2}"    # read-only - view role
: "${GIT_REPO_NAME:=guestbook}"   # repo in the Gitea org (common/env.sh GITEA_ORG)
# Clone URL - the public route, the same URL Import from Git is given. Task
# pods trust its certificate thanks to common/manifests/tektonconfig-git-ca.patch.yaml
# (applied by faa-demo/playbook.yml)
GIT_REPO_URL="${GITEA_URL}/${GITEA_ORG}/${GIT_REPO_NAME}.git"
# What people open in a browser
GIT_REPO_WEB_URL="${GITEA_URL}/${GITEA_ORG}/${GIT_REPO_NAME}"
# Gitea calls the EventListener service directly inside the cluster
EL_URL="http://el-guestbook.${NS}.svc.cluster.local:8080"
