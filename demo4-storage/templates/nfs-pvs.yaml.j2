# Part 2 (setup, as admin): ten static NFS volumes, one per subdirectory of
# the export (pv1..pv10 - nfs-pvN is directory pvN). Sizes vary so the binder's "smallest that fits" shows: a
# 1.5Gi claim gets a 2Gi PV. The size is only a label - NFS has no quota.
# Rendered by the setup automation with nfs_server / nfs_export (demo.env:
# NFS_SERVER / NFS_EXPORT).
{% for n in range(1, 11) %}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: nfs-pv{{ n }}
  labels:
    storage: nfs-static
    app.kubernetes.io/part-of: demo4-storage
spec:
  storageClassName: nfs-static
  capacity:
    storage: {{ '1Gi' if n <= 5 else ('2Gi' if n <= 8 else '5Gi') }}
  accessModes: [ReadWriteMany, ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  mountOptions: [nfsvers=4.1, hard]
  nfs:
    server: {{ nfs_server }}
    path: {{ nfs_export }}/pv{{ n }}
{% endfor %}
